# Business Card Scanner — environment variables
# Copy to .env (or export in your shell). All variables are optional.

# ── Cloud LLM fallbacks (used only if local Ollama/vLLM are unavailable) ──
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Optional OCR post-correction (off by default) ──────────────────────────
# When set, the Ollama OCR pipeline pipes the raw OCR text + the regex
# parser's best guess through this small instruction-following model
# (constrained JSON output) to fix typos, lost accents, and field swaps.
# Adds ~2-5s per card. Recommended: qwen2.5:3b (compact, fast, accurate).
# OCR_POST_CORRECTION_MODEL=qwen2.5:3b

# ── macOS only: zbar library path for QR reading ───────────────────────────
# Needed when running `python3 server.py` directly. The bundled
# BusinessCardScanner.app sets this for you automatically.
# DYLD_LIBRARY_PATH=/opt/homebrew/lib
